# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/telegram_earning_app

# JWT Secret (Change this!)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Admin Credentials (Change these!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_USERNAME=miniFaucet_bot
MINI_APP_NAME=miniFaucet

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# App Configuration
APP_NAME=MiniFaucet
CURRENCY_SYMBOL=₮
DEFAULT_FAUCET_REWARD=0.1
DEFAULT_FAUCET_COOLDOWN=60
DEFAULT_REFERRAL_COMMISSION=10
MIN_WITHDRAWAL_AMOUNT=1

# License Configuration (Optional)
# LICENSE_CLIENT_SECRET=your_license_client_secret
# APP_DOMAIN=your-app-domain.com

# Falls back to JWT_SECRET if not set
ACTION_TOKEN_SECRET=your-secret
AD_SESSION_SECRET=your-secret  
PEERED_SESSION_SECRET=your-secret

# Frontend Environment Variables (for React - use in frontend/.env)
# REACT_APP_API_URL=http://localhost:5000/api
# REACT_APP_TELEGRAM_BOT_USERNAME=miniFaucet_bot
# REACT_APP_MINI_APP_NAME=miniFaucet